<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Social_Network"
             x:Class="Social_Network.App"
             xmlns:converters="clr-namespace:Social_Network.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:DateTimeCnverter x:Key="DateTimeCnverter" />
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:AllTrueConverter x:Key="AllTrueConverter" />
            <converters:ImageMessageConverter x:Key="ImageMessageConverter" />
            <converters:MediaUrlConverter x:Key="MediaUrlConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
