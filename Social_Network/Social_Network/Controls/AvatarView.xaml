<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Social_Network.Controls.AvatarView"
             x:Name="Root"
             HorizontalOptions="Center"
             VerticalOptions="Center">

    <!-- Жёсткая круглая обрезка всего содержимого -->
    <Grid x:Name="Holder" HorizontalOptions="Center" VerticalOptions="Center">
        <Grid.Clip>
            <shapes:EllipseGeometry x:Name="Clip" Center="24,24" RadiusX="24" RadiusY="24" />
        </Grid.Clip>

        <!-- Фон-круг -->
        <BoxView BackgroundColor="{StaticResource AppBrown}" />

        <!-- Заглушка-силуэт (когда фото нет): тело касается нижнего края круга -->
        <Path x:Name="Silhouette"
              Aspect="Fill"
              Fill="{StaticResource AppTextOnDark}"
              Data="M50,20 C61,20 70,29 70,40 C70,51 61,60 50,60 C39,60 30,51 30,40 C30,29 39,20 50,20 Z M50,64 C28,64 12,80 12,100 L88,100 C88,80 72,64 50,64 Z" />

        <!-- Реальная аватарка -->
        <Image x:Name="Avatar"
               Aspect="AspectFill"
               IsVisible="False" />
    </Grid>
</ContentView>
