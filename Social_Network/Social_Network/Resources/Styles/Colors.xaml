<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ================= ТЕМА ПРИЛОЖЕНИЯ (тёплая: крем / коричневый / оливковый) ================= -->

    <!-- Фоны -->
    <Color x:Key="AppBackground">#F7F1DE</Color>
    <Color x:Key="AppSurface">#FBF6E6</Color>
    <Color x:Key="AppDivider">#D8C9A8</Color>

    <!-- Тёмно-коричневая навигация -->
    <Color x:Key="AppNavBar">#4A2810</Color>
    <Color x:Key="AppSidebarTop">#5C3210</Color>
    <Color x:Key="AppSidebarBottom">#34200C</Color>

    <!-- Коричневые акценты / аватары -->
    <Color x:Key="AppBrown">#6E4A2B</Color>
    <Color x:Key="AppBrownDark">#4A2E16</Color>

    <!-- Поля ввода (бежевый) -->
    <Color x:Key="AppInput">#C4A882</Color>
    <Color x:Key="AppInputDark">#B89B73</Color>

    <!-- Оливковая основная кнопка -->
    <Color x:Key="AppOlive">#5A6E2E</Color>
    <Color x:Key="AppOliveMuted">#75813F</Color>

    <!-- Оранжевые акценты (чипы, плитки фото, активный пункт меню) -->
    <Color x:Key="AppOrange">#C8702A</Color>
    <Color x:Key="AppOrangeBright">#DE8A3A</Color>
    <Color x:Key="AppAccentText">#B5651D</Color>

    <!-- Текст -->
    <Color x:Key="AppTextPrimary">#3B2A1A</Color>
    <Color x:Key="AppTextSecondary">#7A5C3E</Color>
    <Color x:Key="AppTextOnDark">#F3E9D2</Color>

    <!-- Состояния -->
    <Color x:Key="AppError">#8B2020</Color>
    <Color x:Key="AppOnline">#6FBF4B</Color>

    <!-- Цвет меню навигации (для разделителей/обводок/подсветки) -->
    <Color x:Key="AppNavAccent">#5C3210</Color>
    <!-- Полупрозрачный нав-цвет для невыбранных вкладок -->
    <Color x:Key="AppNavAccentSoft">#A38B6B</Color>
    <!-- Фон чата — чуть темнее основного -->
    <Color x:Key="AppChatBackground">#EFE6CF</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurface}"/>
    <SolidColorBrush x:Key="AppNavBarBrush" Color="{StaticResource AppNavBar}"/>
    <SolidColorBrush x:Key="AppBrownBrush" Color="{StaticResource AppBrown}"/>
    <SolidColorBrush x:Key="AppInputBrush" Color="{StaticResource AppInput}"/>
    <SolidColorBrush x:Key="AppOliveBrush" Color="{StaticResource AppOlive}"/>
    <SolidColorBrush x:Key="AppOrangeBrush" Color="{StaticResource AppOrange}"/>

    <!-- ================= Базовые ключи MAUI (перенаправлены на тёплую тему) ================= -->

    <Color x:Key="Primary">#5A6E2E</Color>
    <Color x:Key="PrimaryDark">#75813F</Color>
    <Color x:Key="PrimaryDarkText">#3B2A1A</Color>
    <Color x:Key="Secondary">#C4A882</Color>
    <Color x:Key="SecondaryDarkText">#7A5C3E</Color>
    <Color x:Key="Tertiary">#C8702A</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#C8702A</Color>
    <Color x:Key="MidnightBlue">#3B2A1A</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
