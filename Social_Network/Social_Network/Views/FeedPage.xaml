<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Social_Network.ViewModels"
             xmlns:models="clr-namespace:Social_Network.Core.Models;assembly=Social_Network.Core"
             xmlns:controls="clr-namespace:Social_Network.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Social_Network.Views.FeedPage"
             x:DataType="vm:FeedViewModel"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{OnIdiom Phone=0, Default=220}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="{OnIdiom Phone=84, Default=0}" />
        </Grid.RowDefinitions>

        <controls:AppNavBar Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Mode="Sidebar" Current="Feed" />

        <Grid Grid.Column="1" Grid.Row="0"
              ColumnDefinitions="{OnIdiom Phone='*', Default='Auto,620,Auto'}"
              HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}"
              VerticalOptions="Fill">

            <VerticalStackLayout Grid.Column="0"
                                 IsVisible="{OnIdiom Phone=False, Default=True}"
                                 Spacing="8" VerticalOptions="Start" Margin="0,58,14,0">
                <Button Text="Дата" Command="{Binding SelectDateSortCommand}"
                        BackgroundColor="{Binding DateSortTabColor}" TextColor="White"
                        CornerRadius="12" HeightRequest="34" FontSize="12" WidthRequest="88" />
                <Button Text="Лайки" Command="{Binding SelectPopularitySortCommand}"
                        BackgroundColor="{Binding PopularitySortTabColor}" TextColor="White"
                        CornerRadius="12" HeightRequest="34" FontSize="12" WidthRequest="88" />
            </VerticalStackLayout>

            <Grid Grid.Column="{OnIdiom Phone=0, Default=1}" RowDefinitions="Auto,*">

            <Grid Grid.Row="0" ColumnDefinitions="*,*,Auto" Margin="12,10,12,4" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Все" Command="{Binding SelectAllFeedCommand}"
                        BackgroundColor="{Binding AllFeedTabColor}" TextColor="White"
                        CornerRadius="14" HeightRequest="38" FontSize="14" />
                <Button Grid.Column="1" Text="Подписки" Command="{Binding SelectFollowingFeedCommand}"
                        BackgroundColor="{Binding FollowingFeedTabColor}" TextColor="White"
                        CornerRadius="14" HeightRequest="38" FontSize="14" />
                <Button Grid.Column="2" Text="⋮" Command="{Binding OpenFilterModalCommand}"
                        IsVisible="{OnIdiom Phone=True, Default=False}"
                        BackgroundColor="{StaticResource AppBackground}" TextColor="{StaticResource AppTextPrimary}"
                        BorderColor="{StaticResource AppNavAccent}" BorderWidth="2"
                        CornerRadius="14" HeightRequest="38" WidthRequest="42" FontSize="20" Padding="0" />
            </Grid>

            <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadFeedCommand}">
                <CollectionView x:Name="FeedCollection" ItemsSource="{Binding Posts}"
                                ItemsUpdatingScrollMode="KeepScrollOffset">

                    <!-- Истории как шапка списка — скроллятся вместе с лентой -->
                    <CollectionView.Header>
                      <VerticalStackLayout Spacing="0">
                        <ScrollView Orientation="Horizontal" HeightRequest="100" IsVisible="{Binding HasStories}"
                                    HorizontalScrollBarVisibility="Never" Padding="6,8">
                            <HorizontalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Stories}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StoryItem">
                                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                            <Border Stroke="{StaticResource AppOrange}" StrokeThickness="2.5"
                                                    WidthRequest="68" HeightRequest="68" Padding="3" HorizontalOptions="Center">
                                                <Border.StrokeShape>
                                                    <Ellipse />
                                                </Border.StrokeShape>
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsViewed}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource AppDivider}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <controls:AvatarView Source="{Binding AvatarUrl}" Size="58" />
                                            </Border>
                                            <Label Text="{Binding Login}" FontSize="11" MaxLines="1" LineBreakMode="TailTruncation"
                                                   HorizontalOptions="Center" TextColor="{StaticResource AppTextSecondary}"
                                                   WidthRequest="68" HorizontalTextAlignment="Center" />
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.OpenStoryCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                    CommandParameter="{Binding .}" />
                                            </VerticalStackLayout.GestureRecognizers>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                        <!-- Жирная полоска цвета меню навигации, отделяющая сторис -->
                        <BoxView IsVisible="{Binding HasStories}" HeightRequest="4"
                                 Color="{StaticResource AppNavAccent}" BackgroundColor="{StaticResource AppNavAccent}" />
                      </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FeedPostViewModel">
                            <Border BackgroundColor="{StaticResource AppSurface}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18" Margin="12,8">
                                <VerticalStackLayout Spacing="0">

                                    <!-- Шапка поста -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,12,14,10">
                                        <controls:AvatarView Grid.Column="0" Source="{Binding AuthorAvatar}" Size="44">
                                            <controls:AvatarView.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.OpenProfileCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                    CommandParameter="{Binding .}" />
                                            </controls:AvatarView.GestureRecognizers>
                                        </controls:AvatarView>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding AuthorLogin}" TextColor="{StaticResource AppAccentText}"
                                                   FontAttributes="Bold" FontSize="15">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding BindingContext.OpenProfileCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        CommandParameter="{Binding .}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Button Text="{Binding FollowText}" BackgroundColor="{Binding FollowColor}" TextColor="{Binding FollowTextColor}"
                                                    CornerRadius="14" HeightRequest="30" Padding="14,0" FontSize="13" HorizontalOptions="Start"
                                                    IsVisible="{Binding IsOwnPost, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                                                    Command="{Binding BindingContext.ToggleFollowCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                    CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                        <Image Grid.Column="2" Source="{Binding SaveIcon}" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.ToggleSaveCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                    CommandParameter="{Binding .}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </Grid>

                                    <!-- Тонкая линия, не доходящая до краёв контейнера -->
                                    <BoxView HeightRequest="1" Color="{StaticResource AppDivider}"
                                             BackgroundColor="{StaticResource AppDivider}" Margin="16,0" />

                                    <!-- Заметка: текст в контейнере с обводкой меню -->
                                    <Border IsVisible="{Binding IsNote}" BackgroundColor="{StaticResource AppInput}"
                                            Stroke="{StaticResource AppNavAccent}" StrokeThickness="2"
                                            StrokeShape="RoundRectangle 12" Margin="14,12" Padding="14,12">
                                        <Label Text="{Binding Content}" TextColor="{StaticResource AppTextPrimary}" FontSize="14" LineHeight="1.25" />
                                    </Border>

                                    <!-- Фото (без оранжевого фона) -->
                                    <Border IsVisible="{Binding HasImage}" BackgroundColor="Transparent" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            HeightRequest="{OnIdiom Phone=320, Default=440}" Margin="14,12,14,8">
                                        <Image Source="{Binding ImageUrl, Converter={StaticResource MediaUrlConverter}}" Aspect="AspectFit" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.GoToPostDetailCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                    <Label IsVisible="{Binding HasPhotoDescription}" Text="{Binding Content}"
                                           TextColor="{StaticResource AppTextPrimary}" FontSize="14" Margin="16,0,16,8" />

                                    <!-- Хэштеги (оливковые) + отметки (контур) -->
                                    <FlexLayout Wrap="Wrap" IsVisible="{Binding HasTags}" Margin="14,0,14,0"
                                                BindableLayout.ItemsSource="{Binding Tags}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border BackgroundColor="{StaticResource AppOlive}" StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 12" Padding="10,3" Margin="0,0,6,6">
                                                    <Label Text="{Binding .}" FontSize="12" TextColor="White" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                    <FlexLayout Wrap="Wrap" IsVisible="{Binding HasMentions}" Margin="14,0,14,4"
                                                BindableLayout.ItemsSource="{Binding MentionUsers}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:User">
                                                <Border BackgroundColor="{StaticResource AppSurface}" Stroke="{StaticResource AppOrange}" StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 12" Padding="10,3" Margin="0,0,6,6">
                                                    <Label Text="{Binding Login, StringFormat='@{0}'}" FontSize="12" TextColor="{StaticResource AppAccentText}" />
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding BindingContext.OpenUserCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>

                                    <!-- Действия: только обводка цвета таб-бара, нижние углы скруглены сильнее -->
                                    <Border BackgroundColor="Transparent" Stroke="{StaticResource AppNavBar}" StrokeThickness="2"
                                            Padding="16,10" Margin="0,4,0,0">
                                        <Border.StrokeShape>
                                            <shapes:RoundRectangle CornerRadius="6,6,18,18" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                                <Image Source="{Binding LikeIcon}" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding BindingContext.ToggleLikeCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                            CommandParameter="{Binding .}" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                <Label Text="{Binding LikeCount}" TextColor="{StaticResource AppTextPrimary}" FontSize="14" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Grid.Column="1" Spacing="6" Margin="14,0,0,0">
                                                <Image Source="icon_comments.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding BindingContext.GoToPostDetailCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                            CommandParameter="{Binding .}" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                <Label Text="{Binding CommentCount}" TextColor="{StaticResource AppTextPrimary}" FontSize="14" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Image Grid.Column="3" Source="icon_to_shair_for_feed.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding BindingContext.ShareCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        CommandParameter="{Binding .}" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Label Text="Здесь пока пусто. Создайте пост или подпишитесь на кого-нибудь."
                               TextColor="{StaticResource AppTextSecondary}" HorizontalTextAlignment="Center" Margin="32,60,32,0" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>
            </Grid>

            <VerticalStackLayout Grid.Column="2"
                                 IsVisible="{OnIdiom Phone=False, Default=True}"
                                 Spacing="8" VerticalOptions="Start" Margin="14,58,0,0">
                <Button Text="↑" Command="{Binding SelectAscSortCommand}"
                        BackgroundColor="{Binding AscSortTabColor}" TextColor="White"
                        CornerRadius="12" HeightRequest="34" FontSize="14" WidthRequest="42" />
                <Button Text="↓" Command="{Binding SelectDescSortCommand}"
                        BackgroundColor="{Binding DescSortTabColor}" TextColor="White"
                        CornerRadius="12" HeightRequest="34" FontSize="14" WidthRequest="42" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2"
              IsVisible="{Binding IsFilterModalOpen}"
              BackgroundColor="#80000000"
              ZIndex="100"
              InputTransparent="False">
            <Border BackgroundColor="{StaticResource AppSurface}" Stroke="{StaticResource AppNavAccent}"
                    StrokeThickness="2" StrokeShape="RoundRectangle 18"
                    Padding="20,18" Margin="32" VerticalOptions="Center" HorizontalOptions="Center"
                    MaximumWidthRequest="340">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Сортировка ленты" FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource AppTextPrimary}" HorizontalTextAlignment="Center" />
                    <Label Text="Критерий" FontSize="13" TextColor="{StaticResource AppTextSecondary}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Дата" Command="{Binding SelectDateSortCommand}"
                                BackgroundColor="{Binding DateSortTabColor}" TextColor="White"
                                CornerRadius="12" HeightRequest="38" FontSize="13" />
                        <Button Grid.Column="1" Text="Лайки" Command="{Binding SelectPopularitySortCommand}"
                                BackgroundColor="{Binding PopularitySortTabColor}" TextColor="White"
                                CornerRadius="12" HeightRequest="38" FontSize="13" />
                    </Grid>
                    <Label Text="Порядок" FontSize="13" TextColor="{StaticResource AppTextSecondary}" />
                    <VerticalStackLayout Spacing="8">
                        <Border BackgroundColor="{Binding DescSortTabColor}" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12" HeightRequest="44">
                            <Label Text="↓ Новые / больше" TextColor="White" FontSize="13"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   HorizontalOptions="Fill" VerticalOptions="Fill" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectDescSortCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border BackgroundColor="{Binding AscSortTabColor}" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12" HeightRequest="44">
                            <Label Text="↑ Старые / меньше" TextColor="White" FontSize="13"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   HorizontalOptions="Fill" VerticalOptions="Fill" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectAscSortCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>
                    <Button Text="Закрыть" Command="{Binding CloseFilterModalCommand}"
                            BackgroundColor="{StaticResource AppNavAccent}" TextColor="White"
                            CornerRadius="14" HeightRequest="40" FontSize="14" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <controls:AppNavBar Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Mode="Bottom" Current="Feed" />
    </Grid>
</ContentPage>
