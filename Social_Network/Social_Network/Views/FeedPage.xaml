<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Social_Network.Views.FeedPage"
             BackgroundColor="#F5F0E8"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, 70">

        <!-- Лента постов -->
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Posts}"
                        Margin="0,8,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="12,6"
                           Padding="14"
                           BackgroundColor="White"
                           CornerRadius="16"
                           BorderColor="#E8E0D0"
                           HasShadow="False">
                        <StackLayout Spacing="10">

                            <!-- Шапка: аватар + имя + подписаться + закладка -->
                            <Grid ColumnDefinitions="44, *, Auto">
                                <!-- Аватар -->
                                <Frame Grid.Column="0"
                                       WidthRequest="44"
                                       HeightRequest="44"
                                       CornerRadius="22"
                                       Padding="0"
                                       IsClippedToBounds="True"
                                       BorderColor="Transparent"
                                       BackgroundColor="#5C3317">
                                    <Image Source="{Binding AvatarUrl}"
                                           Aspect="AspectFill"
                                           WidthRequest="44"
                                           HeightRequest="44"/>
                                </Frame>

                                <!-- Имя + кнопка подписаться -->
                                <StackLayout Grid.Column="1"
                                             Margin="10,0,0,0"
                                             Spacing="4"
                                             VerticalOptions="Center">
                                    <Label Text="{Binding UserLogin}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#2C1A0E"/>
                                    <Frame Padding="8,3"
                                           CornerRadius="10"
                                           BackgroundColor="#C2692A"
                                           BorderColor="Transparent"
                                           HorizontalOptions="Start">
                                        <Label Text="Подписаться"
                                               FontSize="11"
                                               TextColor="White"/>
                                    </Frame>
                                </StackLayout>

                                <!-- Закладка -->
                                <Label Grid.Column="2"
                                       Text="🔖"
                                       FontSize="20"
                                       VerticalOptions="Start"/>
                            </Grid>

                            <!-- Изображение поста (если есть) -->
                            <Frame IsVisible="{Binding HasImage}"
                                   Padding="0"
                                   CornerRadius="12"
                                   IsClippedToBounds="True"
                                   BorderColor="Transparent"
                                   HeightRequest="180"
                                   BackgroundColor="#D4873A">
                                <Image Source="{Binding ImageUrl}"
                                       Aspect="AspectFill"/>
                            </Frame>

                            <!-- Текст поста -->
                            <Label Text="{Binding Content}"
                                   FontSize="14"
                                   TextColor="#2C1A0E"
                                   LineBreakMode="WordWrap"/>

                            <!-- Нижняя панель: лайки, комменты, поделиться -->
                            <BoxView HeightRequest="1"
                                     Color="#E8E0D0"/>
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                <!-- Лайк -->
                                <StackLayout Grid.Column="0"
                                             Orientation="Horizontal"
                                             Spacing="4">
                                    <Label Text="♥"
                                           FontSize="18"
                                           TextColor="#C2692A"/>
                                    <Label Text="{Binding LikesCount}"
                                           FontSize="13"
                                           TextColor="#7A5C3E"
                                           VerticalOptions="Center"/>
                                </StackLayout>

                                <!-- Комментарии -->
                                <StackLayout Grid.Column="1"
                                             Orientation="Horizontal"
                                             Spacing="4"
                                             Margin="16,0,0,0">
                                    <Label Text="💬"
                                           FontSize="16"
                                           TextColor="#7A5C3E"/>
                                    <Label Text="{Binding CommentsCount}"
                                           FontSize="13"
                                           TextColor="#7A5C3E"
                                           VerticalOptions="Center"/>
                                </StackLayout>

                                <!-- Поделиться -->
                                <Label Grid.Column="3"
                                       Text="✈"
                                       FontSize="18"
                                       TextColor="#7A5C3E"
                                       HorizontalOptions="End"/>
                            </Grid>

                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Нижняя навигация -->
        <Frame Grid.Row="1"
       BackgroundColor="#3D1F0A"
       Padding="0"
       CornerRadius="0"
       BorderColor="Transparent">
            <Grid ColumnDefinitions="*,*,*,*,*"
          VerticalOptions="Center">

                <!-- Главная (активная) -->
                <Frame Grid.Column="0"
               BackgroundColor="#5C3317"
               CornerRadius="20"
               Padding="10,8"
               Margin="8,6"
               BorderColor="Transparent"
               HorizontalOptions="Center">
                    <Label Text="⌂" FontSize="22" TextColor="White"
                   HorizontalOptions="Center"/>
                </Frame>

                <!-- Поиск -->
                <Label Grid.Column="1" Text="🔍" FontSize="22"
               TextColor="#A07858"
               HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTapped"/>
                    </Label.GestureRecognizers>
                </Label>

                <!-- Создать пост -->
                <Label Grid.Column="2" Text="⊕" FontSize="26"
               TextColor="#A07858"
               HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreatePostTapped"/>
                    </Label.GestureRecognizers>
                </Label>

                <!-- Сообщения -->
                <Label Grid.Column="3" Text="⋯" FontSize="26"
               TextColor="#A07858"
               HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMessagesTapped"/>
                    </Label.GestureRecognizers>
                </Label>

                <!-- Профиль -->
                <Label Grid.Column="4" Text="👤" FontSize="22"
               TextColor="#A07858"
               HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped"/>
                    </Label.GestureRecognizers>
                </Label>

            </Grid>
        </Frame>
    </Grid>
</ContentPage>