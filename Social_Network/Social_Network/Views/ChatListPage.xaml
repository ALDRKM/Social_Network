<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Social_Network.ViewModels"
             xmlns:dto="clr-namespace:Social_Network.Core.Models.DTOs;assembly=Social_Network.Core"
             xmlns:models="clr-namespace:Social_Network.Core.Models;assembly=Social_Network.Core"
             xmlns:controls="clr-namespace:Social_Network.Controls"
             x:Class="Social_Network.Views.ChatListPage"
             x:DataType="vm:ChatsListViewModel"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{OnIdiom Phone=0, Default=220}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="{OnIdiom Phone=84, Default=0}" />
        </Grid.RowDefinitions>

        <controls:AppNavBar Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Mode="Sidebar" Current="Chat" />

        <Grid Grid.Column="1" Grid.Row="0" RowDefinitions="Auto,*"
              WidthRequest="{OnIdiom Phone=-1, Default=680}"
              HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}">

            <!-- Поиск -->
            <Border Grid.Row="0" BackgroundColor="{StaticResource AppInput}"
                    Stroke="{StaticResource AppBrown}" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                    Margin="14,12,14,6" Padding="14,0" HeightRequest="46">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Grid.Column="0" Text="{Binding SearchQuery}"
                           Placeholder="Поиск людей  @логин"
                           PlaceholderColor="{StaticResource AppTextSecondary}"
                           TextColor="{StaticResource AppTextPrimary}"
                           BackgroundColor="Transparent" VerticalOptions="Center" />
                    <Image Grid.Column="1" Source="icon_search.png" WidthRequest="22" HeightRequest="22"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Найденные пользователи (начать чат) -->
            <CollectionView Grid.Row="1" ItemsSource="{Binding FoundUsers}"
                            IsVisible="{Binding IsSearching}" Margin="8,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:User">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="10,8">
                            <controls:AvatarView Grid.Column="0" Source="{Binding AvatarUrl}" Size="48" />
                            <Label Grid.Column="1" Text="{Binding Login}" VerticalOptions="Center"
                                   FontAttributes="Bold" FontSize="15" TextColor="{StaticResource AppAccentText}" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.StartChatCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Список чатов (последние сверху) -->
            <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadChatsCommand}"
                         IsVisible="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                <CollectionView ItemsSource="{Binding Chats}" Margin="6,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:ChatDto">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="10,10">
                                    <!-- Аватар + индикатор онлайн -->
                                    <Grid Grid.Column="0" WidthRequest="52" HeightRequest="52">
                                        <controls:AvatarView Source="{Binding OtherUserAvatarUrl}" Size="52" />
                                        <Border IsVisible="{Binding OtherUserIsOnline}"
                                                BackgroundColor="{StaticResource AppOnline}" Stroke="{StaticResource AppBackground}" StrokeThickness="2"
                                                WidthRequest="15" HeightRequest="15"
                                                HorizontalOptions="End" VerticalOptions="End">
                                            <Border.StrokeShape>
                                                <Ellipse />
                                            </Border.StrokeShape>
                                        </Border>
                                    </Grid>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding OtherUserLogin}" FontAttributes="Bold" FontSize="15"
                                               TextColor="{StaticResource AppAccentText}" />
                                        <Label Text="{Binding LastMessage.Text}" FontSize="13"
                                               TextColor="{StaticResource AppTextSecondary}"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding LastMessage.SentAt, Converter={StaticResource DateTimeCnverter}}"
                                           FontSize="11" TextColor="{StaticResource AppTextSecondary}" VerticalOptions="Start" />
                                </Grid>
                                <!-- Тонкий разделитель, не доходящий до краёв -->
                                <BoxView HeightRequest="1" Color="{StaticResource AppDivider}"
                                         BackgroundColor="{StaticResource AppDivider}" Margin="20,0" />
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.OpenChatCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="Пока нет переписок. Найдите кого-нибудь через поиск выше."
                               TextColor="{StaticResource AppTextSecondary}"
                               HorizontalTextAlignment="Center" Margin="32,40,32,0" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>
        </Grid>

        <controls:AppNavBar Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Mode="Bottom" Current="Chat" />
    </Grid>
</ContentPage>
