<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Social_Network.ViewModels"
             xmlns:models="clr-namespace:Social_Network.Core.Models;assembly=Social_Network.Core"
             xmlns:controls="clr-namespace:Social_Network.Controls"
             x:Class="Social_Network.Views.CreatePostPage"
             x:DataType="vm:CreatePostViewModel"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{OnIdiom Phone=0, Default=220}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:AppNavBar Grid.Column="0" Mode="Sidebar" Current="Create" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*,Auto"
              WidthRequest="{OnIdiom Phone=-1, Default=560}"
              HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}">

            <!-- Шапка -->
            <Grid Grid.Row="0" ColumnDefinitions="48,*,48" Padding="14,16,14,8">
                <Image Grid.Column="0" Source="icon_to_cansel.png" WidthRequest="38" HeightRequest="38"
                       HorizontalOptions="Start" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelCommand}" />
                    </Image.GestureRecognizers>
                </Image>
                <Label Grid.Column="1" Text="{Binding HeaderTitle}"
                       Style="{StaticResource PageTitle}" FontSize="18" VerticalOptions="Center" />
                <Image Grid.Column="2" Source="icon_to_ready_for_addpostsornotes_and_settings.png"
                       WidthRequest="38" HeightRequest="38" HorizontalOptions="End" VerticalOptions="Center"
                       IsVisible="{OnIdiom Phone=True, Default=False}">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PublishCommand}" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="14,4,14,16" Spacing="12">

                    <!-- ===== ФОТО ===== -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsPhotoTabSelected}">
                        <Button Text="Добавить фото" Command="{Binding PickImagesCommand}"
                                Style="{StaticResource PrimaryButton}" HeightRequest="46" />

                        <ActivityIndicator IsRunning="{Binding IsUploading}" IsVisible="{Binding IsUploading}"
                                            Color="{StaticResource AppOlive}" />

                        <!-- Одно фото целиком -->
                        <Border IsVisible="{Binding HasImage}" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                BackgroundColor="{StaticResource AppSurface}"
                                HeightRequest="{OnIdiom Phone=320, Default=380}">
                            <Grid>
                                <Image Source="{Binding SelectedImage, Converter={StaticResource MediaUrlConverter}}" Aspect="AspectFit" />
                                <Image Source="icon_to_cansel.png" WidthRequest="30" HeightRequest="30"
                                       HorizontalOptions="End" VerticalOptions="Start" Margin="6">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding RemoveImageCommand}" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </Border>

                        <Border BackgroundColor="{StaticResource AppInput}" StrokeThickness="0"
                                StrokeShape="RoundRectangle 14" Padding="12,8">
                            <Editor Placeholder="Добавить описание ..." Text="{Binding Description}"
                                    PlaceholderColor="{StaticResource AppTextSecondary}"
                                    TextColor="{StaticResource AppTextPrimary}"
                                    BackgroundColor="Transparent" AutoSize="TextChanges" MinimumHeightRequest="80" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- ===== ЗАМЕТКА ===== -->
                    <Border IsVisible="{Binding IsNoteTabSelected}"
                            BackgroundColor="{StaticResource AppInput}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 16" Padding="12" MinimumHeightRequest="180">
                        <Editor Placeholder="Текст заметки ..." Text="{Binding NoteText}"
                                PlaceholderColor="{StaticResource AppTextSecondary}"
                                TextColor="{StaticResource AppTextPrimary}"
                                BackgroundColor="Transparent" AutoSize="TextChanges" MinimumHeightRequest="160" />
                    </Border>

                    <!-- Сводка под описанием: добавленные теги и отмеченные люди (после «Готово») -->
                    <VerticalStackLayout Spacing="8" Margin="0,2,0,0">
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding HasSelectedTags}">
                            <Label Text="Теги" FontSize="12" TextColor="{StaticResource AppTextSecondary}" />
                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding SelectedTags}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border BackgroundColor="{StaticResource AppOrange}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="10,4" Margin="0,0,6,6">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="✕" TextColor="White" FontSize="13" VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding BindingContext.RemoveTagCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                            CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                                <Label Text="{Binding ., StringFormat='#{0}'}" TextColor="White" FontSize="13" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource AppDivider}" BackgroundColor="{StaticResource AppDivider}"
                                 IsVisible="{Binding HasTagsAndMentions}" />

                        <VerticalStackLayout Spacing="6" IsVisible="{Binding HasSelectedMentions}">
                            <Label Text="Отмеченные люди" FontSize="12" TextColor="{StaticResource AppTextSecondary}" />
                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding SelectedMentions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:User">
                                        <Border BackgroundColor="{StaticResource AppOlive}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="10,4" Margin="0,0,6,6">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="✕" TextColor="White" FontSize="13" VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding BindingContext.RemoveMentionCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                            CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                                <Label Text="{Binding Login, StringFormat='@{0}'}" TextColor="White" FontSize="13" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Кнопки: Добавить хэштег / Отметить -->
                    <Button Text="{Binding HashtagButtonText}" Command="{Binding ToggleHashtagPanelCommand}"
                            BackgroundColor="{StaticResource AppOlive}" TextColor="White" CornerRadius="12" HeightRequest="46" />

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowHashtagPanel}">
                        <Border BackgroundColor="{StaticResource AppInput}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,2">
                            <Entry Placeholder="Введите тег и выберите из списка" Text="{Binding TagQuery}"
                                   PlaceholderColor="{StaticResource AppTextSecondary}"
                                   TextColor="{StaticResource AppTextPrimary}" BackgroundColor="Transparent"
                                   ReturnCommand="{Binding AddTagCommand}" />
                        </Border>
                        <Border IsVisible="{Binding HasTagSuggestions}" BackgroundColor="{StaticResource AppSurface}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="4">
                            <CollectionView ItemsSource="{Binding TagSuggestions}" HeightRequest="130">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Label Text="{Binding ., StringFormat='#{0}'}" Padding="10,8"
                                               TextColor="{StaticResource AppAccentText}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.AddTagCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="{Binding MentionButtonText}" Command="{Binding ToggleMentionPanelCommand}"
                            BackgroundColor="#46541F" TextColor="White" CornerRadius="12" HeightRequest="46" />

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowMentionPanel}">
                        <Border BackgroundColor="{StaticResource AppInput}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,2">
                            <Entry Placeholder="Введите @логин и выберите из списка" Text="{Binding MentionQuery}"
                                   PlaceholderColor="{StaticResource AppTextSecondary}"
                                   TextColor="{StaticResource AppTextPrimary}" BackgroundColor="Transparent" />
                        </Border>
                        <Border IsVisible="{Binding HasMentionSuggestions}" BackgroundColor="{StaticResource AppSurface}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="4">
                            <CollectionView ItemsSource="{Binding MentionSuggestions}" HeightRequest="150">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:User">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="8,6">
                                            <controls:AvatarView Grid.Column="0" Source="{Binding AvatarUrl}" Size="34" />
                                            <Label Grid.Column="1" Text="{Binding Login}" VerticalOptions="Center"
                                                   TextColor="{StaticResource AppAccentText}" FontAttributes="Bold" />
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.AddMentionCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource AppError}"
                           FontSize="13" HorizontalTextAlignment="Center"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                    <!-- Опубликовать (только ПК): кремовая с обводкой, как на скрине -->
                    <Button Text="Опубликовать" Command="{Binding PublishCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="{StaticResource AppBackground}" TextColor="{StaticResource AppTextPrimary}"
                            BorderColor="{StaticResource AppNavAccent}" BorderWidth="2" CornerRadius="24" HeightRequest="50"
                            FontAttributes="Bold" Margin="0,4,0,0" IsVisible="{OnIdiom Phone=False, Default=True}" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- Переключатель Фото / Заметка -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" Padding="14,8,14,16" ColumnSpacing="10">
                <Border Grid.Column="0" BackgroundColor="{Binding PhotoTabBackground}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="44">
                    <Label Text="Фото" FontAttributes="Bold" TextColor="{Binding PhotoTabTextColor}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPhotoTabCommand}" />
                    </Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="1" BackgroundColor="{Binding NoteTabBackground}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="44">
                    <Label Text="Заметка" FontAttributes="Bold" TextColor="{Binding NoteTabTextColor}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectNoteTabCommand}" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
