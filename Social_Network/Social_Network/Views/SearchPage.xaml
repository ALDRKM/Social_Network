<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Social_Network.ViewModels"
             xmlns:models="clr-namespace:Social_Network.Core.Models;assembly=Social_Network.Core"
             xmlns:controls="clr-namespace:Social_Network.Controls"
             x:Class="Social_Network.Views.SearchPage"
             x:DataType="vm:SearchViewModel"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{OnIdiom Phone=0, Default=220}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="{OnIdiom Phone=84, Default=0}" />
        </Grid.RowDefinitions>

        <controls:AppNavBar Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Mode="Sidebar" Current="Search" />

        <Grid Grid.Column="1" Grid.Row="0" RowDefinitions="Auto,Auto,*"
              WidthRequest="{OnIdiom Phone=-1, Default=680}"
              HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}">

            <!-- Поисковая строка -->
            <Border Grid.Row="0" BackgroundColor="{StaticResource AppInput}"
                    Stroke="{StaticResource AppBrown}" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                    Margin="14,12,14,6" Padding="14,0" HeightRequest="46">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Grid.Column="0" Text="{Binding SearchQuery}"
                           Placeholder="Поиск  @логин  или  #тег"
                           PlaceholderColor="{StaticResource AppTextSecondary}"
                           TextColor="{StaticResource AppTextPrimary}"
                           BackgroundColor="Transparent" VerticalOptions="Center" />
                    <Path Grid.Column="1" WidthRequest="22" HeightRequest="22" Aspect="Uniform"
                          Stroke="{StaticResource AppBrown}" StrokeThickness="6" StrokeLineCap="Round" Fill="Transparent"
                          VerticalOptions="Center" Data="M44,18 A25,25 0 1,0 44,68 A25,25 0 1,0 44,18 Z M61,61 L84,84" />
                </Grid>
            </Border>

            <!-- Что ищем -->
            <Label Grid.Row="1" Text="{Binding StatusText}" TextColor="{StaticResource AppTextSecondary}"
                   FontSize="12" Margin="18,0,14,6" />

            <!-- Пользователи (@) -->
            <CollectionView Grid.Row="2" ItemsSource="{Binding Users}"
                            IsVisible="{Binding IsUsersMode}" Margin="8,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:User">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="10,8">
                            <controls:AvatarView Grid.Column="0" Source="{Binding AvatarUrl}" Size="48" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Login}" FontAttributes="Bold"
                                       TextColor="{StaticResource AppAccentText}" FontSize="15" />
                                <Label Text="{Binding Bio}" TextColor="{StaticResource AppTextSecondary}"
                                       FontSize="12" LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.GoToUserProfileCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Никого не найдено" TextColor="{StaticResource AppTextSecondary}"
                           HorizontalTextAlignment="Center" Margin="0,40,0,0" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Публикации (сетка квадратов) -->
            <CollectionView Grid.Row="2" ItemsSource="{Binding Posts}"
                            IsVisible="{Binding IsUsersMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                            Margin="10,0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="{OnIdiom Phone=3, Default=5}"
                                     HorizontalItemSpacing="4" VerticalItemSpacing="4" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Post">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource AppOrangeBright}" HeightRequest="110">
                            <Grid>
                                <Image Source="{Binding ImageUrl, Converter={StaticResource MediaUrlConverter}}" Aspect="AspectFill"
                                       IsVisible="{Binding ImageUrl, Converter={StaticResource StringToBoolConverter}}" />
                                <Label Text="{Binding Content}" Padding="8" FontSize="11"
                                       TextColor="White" MaxLines="4" LineBreakMode="TailTruncation"
                                       IsVisible="{Binding ImageUrl, Converter={StaticResource StringToBoolConverter}, ConverterParameter=invert}" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.GoToPostCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Ничего не найдено" TextColor="{StaticResource AppTextSecondary}"
                           HorizontalTextAlignment="Center" Margin="0,40,0,0" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <controls:AppNavBar Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Mode="Bottom" Current="Search" />
    </Grid>
</ContentPage>
