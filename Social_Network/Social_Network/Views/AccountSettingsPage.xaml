<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Social_Network.ViewModels"
             x:Class="Social_Network.Views.AccountSettingsPage"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" Padding="0,14,0,0">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="{OnIdiom Phone='10,0,10,0', Default='40,0,40,0'}">
            <Image Grid.Column="0" Source="icon_to_back.png" WidthRequest="46" HeightRequest="46"
                   HorizontalOptions="Start" VerticalOptions="Center">
                <Image.GestureRecognizers><TapGestureRecognizer Command="{Binding GoBackCommand}" /></Image.GestureRecognizers>
            </Image>
            <Label Grid.Column="1" Text="Аккаунт" Style="{StaticResource PageTitle}" FontSize="22"
                   VerticalOptions="Center" Margin="0,0,46,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20" Spacing="12"
                                 WidthRequest="{OnIdiom Phone=-1, Default=520}"
                                 HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}">
                <Label Text="{Binding StatusMessage}" TextColor="{StaticResource AppOlive}" HorizontalTextAlignment="Center"
                       IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}" />

                <Border Style="{StaticResource InputPill}">
                    <Entry Text="{Binding Login}" Placeholder="Логин" BackgroundColor="Transparent"
                           PlaceholderColor="{StaticResource AppTextSecondary}" TextColor="{StaticResource AppTextPrimary}"
                           VerticalOptions="Center" />
                </Border>
                <Border Style="{StaticResource InputPill}">
                    <Entry Text="{Binding Email}" Placeholder="Эл. почта" Keyboard="Email" BackgroundColor="Transparent"
                           PlaceholderColor="{StaticResource AppTextSecondary}" TextColor="{StaticResource AppTextPrimary}"
                           VerticalOptions="Center" />
                </Border>
                <Button Text="Сохранить аккаунт" Command="{Binding SaveAccountCommand}" Style="{StaticResource PrimaryButton}" />

                <Label Text="Смена пароля" FontAttributes="Bold" TextColor="{StaticResource AppTextSecondary}" Margin="0,10,0,0" />
                <Border Style="{StaticResource InputPill}">
                    <Entry Text="{Binding CurrentPassword}" Placeholder="Текущий пароль" IsPassword="True"
                           BackgroundColor="Transparent" PlaceholderColor="{StaticResource AppTextSecondary}"
                           TextColor="{StaticResource AppTextPrimary}" VerticalOptions="Center" />
                </Border>
                <Border Style="{StaticResource InputPill}">
                    <Entry Text="{Binding NewPassword}" Placeholder="Новый пароль" IsPassword="True"
                           BackgroundColor="Transparent" PlaceholderColor="{StaticResource AppTextSecondary}"
                           TextColor="{StaticResource AppTextPrimary}" VerticalOptions="Center" />
                </Border>
                <Button Text="Изменить пароль" Command="{Binding ChangePasswordCommand}" Style="{StaticResource PrimaryButton}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
