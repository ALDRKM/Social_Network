<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Social_Network.Views.CustomTabBar">

    <!-- Внешний контейнер — тёмно-коричневый фон с закруглением -->
    <Frame
        BackgroundColor="#6B3E1E"
        CornerRadius="40"
        HasShadow="True"
        Padding="12,8"
        Margin="16,0,16,12"
        HeightRequest="64">

        <Grid ColumnDefinitions="*,*,*,*,*" VerticalOptions="Center">

            <!-- Лента (Главная) -->
            <Frame x:Name="HomeBg" Grid.Column="0"
                   BackgroundColor="#C8955A"
                   CornerRadius="14" Padding="0" HasShadow="False"
                   HeightRequest="44" WidthRequest="44"
                   HorizontalOptions="Center" VerticalOptions="Center">
                <Image Source="icon_home.png"
                       HeightRequest="24" WidthRequest="24"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped"/>
                    </Image.GestureRecognizers>
                </Image>
            </Frame>

            <!-- Поиск -->
            <Frame x:Name="SearchBg" Grid.Column="1"
                   BackgroundColor="Transparent"
                   CornerRadius="14" Padding="0" HasShadow="False"
                   HeightRequest="44" WidthRequest="44"
                   HorizontalOptions="Center" VerticalOptions="Center">
                <Image Source="icon_search.png"
                       HeightRequest="24" WidthRequest="24"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTapped"/>
                    </Image.GestureRecognizers>
                </Image>
            </Frame>

            <!-- Создать пост (кнопка +) -->
            <Frame x:Name="CreateBg" Grid.Column="2"
                   BackgroundColor="Transparent"
                   CornerRadius="14" Padding="0" HasShadow="False"
                   HeightRequest="44" WidthRequest="44"
                   HorizontalOptions="Center" VerticalOptions="Center">
                <Image Source="icon_create.png"
                       HeightRequest="24" WidthRequest="24"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreateTapped"/>
                    </Image.GestureRecognizers>
                </Image>
            </Frame>

            <!-- Чаты -->
            <Frame x:Name="ChatBg" Grid.Column="3"
                   BackgroundColor="Transparent"
                   CornerRadius="14" Padding="0" HasShadow="False"
                   HeightRequest="44" WidthRequest="44"
                   HorizontalOptions="Center" VerticalOptions="Center">
                <Image Source="icon_chat.png"
                       HeightRequest="24" WidthRequest="24"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChatTapped"/>
                    </Image.GestureRecognizers>
                </Image>
            </Frame>

            <!-- Профиль -->
            <Frame x:Name="ProfileBg" Grid.Column="4"
                   BackgroundColor="Transparent"
                   CornerRadius="14" Padding="0" HasShadow="False"
                   HeightRequest="44" WidthRequest="44"
                   HorizontalOptions="Center" VerticalOptions="Center">
                <Image Source="icon_profile.png"
                       HeightRequest="24" WidthRequest="24"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped"/>
                    </Image.GestureRecognizers>
                </Image>
            </Frame>

        </Grid>
    </Frame>
</ContentView>