<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Social_Network.ViewModels"
             xmlns:models="clr-namespace:Social_Network.Core.Models;assembly=Social_Network.Core"
             xmlns:controls="clr-namespace:Social_Network.Controls"
             x:Class="Social_Network.Views.OtherProfilePage"
             x:DataType="vm:OtherProfileViewModel"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{OnIdiom Phone=0, Default=220}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="{OnIdiom Phone=84, Default=0}" />
        </Grid.RowDefinitions>

        <controls:AppNavBar Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Mode="Sidebar" Current="Profile" />

        <Grid Grid.Column="1" Grid.Row="0" RowDefinitions="Auto,Auto,Auto,*"
              WidthRequest="{OnIdiom Phone=-1, Default=720}"
              HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}">

            <!-- Назад + поделиться -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="12,12,16,0">
                <Image Grid.Column="0" Source="icon_to_back.png" WidthRequest="32" HeightRequest="32"
                       HorizontalOptions="Start">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Image.GestureRecognizers>
                </Image>
                <Image Grid.Column="2" Source="icon_to_shair.png" WidthRequest="24" HeightRequest="24">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShareCommand}" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>

            <!-- ===== Шапка профиля ===== -->
            <VerticalStackLayout Grid.Row="1" Padding="16,8,16,8" Spacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <controls:AvatarView Grid.Column="0" Source="{Binding User.AvatarUrl}" Size="76" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding User.Login}" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource AppAccentText}" />
                        <Label Text="{Binding User.Bio}" FontSize="13" TextColor="{StaticResource AppTextSecondary}"
                               MaxLines="2" LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="14" Margin="0,4,0,0">
                            <VerticalStackLayout>
                                <Label Text="{Binding FollowersCount}" FontAttributes="Bold" FontSize="14"
                                       TextColor="{StaticResource AppTextPrimary}" HorizontalOptions="Center" />
                                <Label Text="подписчиков" FontSize="11" TextColor="{StaticResource AppTextSecondary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout>
                                <Label Text="{Binding FollowingCount}" FontAttributes="Bold" FontSize="14"
                                       TextColor="{StaticResource AppTextPrimary}" HorizontalOptions="Center" />
                                <Label Text="подписок" FontSize="11" TextColor="{StaticResource AppTextSecondary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout>
                                <Label Text="{Binding PostsCount}" FontAttributes="Bold" FontSize="14"
                                       TextColor="{StaticResource AppTextPrimary}" HorizontalOptions="Center" />
                                <Label Text="публикаций" FontSize="11" TextColor="{StaticResource AppTextSecondary}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <!-- Кнопки: Подписаться / Сообщение -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="{Binding FollowButtonText}" Command="{Binding ToggleFollowCommand}"
                            BackgroundColor="{Binding FollowButtonColor}" TextColor="White"
                            HeightRequest="38" CornerRadius="12" FontSize="13" />
                    <Button Grid.Column="1" Text="Сообщение" Command="{Binding OpenChatCommand}"
                            Style="{StaticResource ChipButton}" HeightRequest="38" CornerRadius="12"
                            BackgroundColor="{StaticResource AppOlive}" />
                </Grid>
            </VerticalStackLayout>

            <!-- ===== Вкладки ===== -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" Padding="16,4,16,8" ColumnSpacing="10">
                <Border Grid.Column="0" BackgroundColor="{Binding PhotosTabColor}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 14" HeightRequest="40">
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="icon_for_images_in_profile.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Фото" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPhotosTabCommand}" />
                    </Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="1" BackgroundColor="{Binding NotesTabColor}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 14" HeightRequest="40">
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="icon_notebook_for_profile_for_notes.png" WidthRequest="20" HeightRequest="20" />
                        <Label Text="Заметки" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectNotesTabCommand}" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <!-- Приватный аккаунт: контент скрыт -->
            <VerticalStackLayout Grid.Row="3"
                                 IsVisible="{Binding CanViewContent, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                                 VerticalOptions="Center" Spacing="8" Padding="32">
                <Label Text="🔒 Это закрытый аккаунт" HorizontalTextAlignment="Center"
                       FontAttributes="Bold" TextColor="{StaticResource AppTextPrimary}" />
                <Label Text="Подпишитесь, чтобы видеть публикации." HorizontalTextAlignment="Center"
                       TextColor="{StaticResource AppTextSecondary}" FontSize="13" />
            </VerticalStackLayout>

            <!-- Заметки -->
            <CollectionView Grid.Row="3" ItemsSource="{Binding Notes}"
                            Margin="12,0">
                <CollectionView.IsVisible>
                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                        <Binding Path="CanViewContent" />
                        <Binding Path="IsNotesTab" />
                    </MultiBinding>
                </CollectionView.IsVisible>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Post">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource AppSurface}" Margin="0,4" Padding="14,12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Content}" TextColor="{StaticResource AppTextPrimary}" FontSize="14" />
                                <Label Text="{Binding CreatedAt, Converter={StaticResource DateTimeCnverter}}"
                                       FontSize="11" TextColor="{StaticResource AppTextSecondary}" />
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenPostCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Фото -->
            <CollectionView Grid.Row="3" ItemsSource="{Binding Photos}" Margin="10,0">
                <CollectionView.IsVisible>
                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                        <Binding Path="CanViewContent" />
                        <Binding Path="IsPhotosTab" />
                    </MultiBinding>
                </CollectionView.IsVisible>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="{OnIdiom Phone=3, Default=4}"
                                     HorizontalItemSpacing="4" VerticalItemSpacing="4" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Post">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource AppOrangeBright}" HeightRequest="120">
                            <Image Source="{Binding ImageUrl, Converter={StaticResource MediaUrlConverter}}" Aspect="AspectFill" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenPostCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <controls:AppNavBar Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Mode="Bottom" Current="Profile" />
    </Grid>
</ContentPage>
