<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Social_Network.ViewModels"
             xmlns:dto="clr-namespace:Social_Network.Core.Models.DTOs;assembly=Social_Network.Core"
             xmlns:controls="clr-namespace:Social_Network.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Social_Network.Views.ChatPage"
             x:DataType="vm:ChatViewModel"
             BackgroundColor="{StaticResource AppChatBackground}"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{OnIdiom Phone=0, Default=220}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:AppNavBar Grid.Column="0" Mode="Sidebar" Current="Chat" />

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*,Auto"
              WidthRequest="{OnIdiom Phone=-1, Default=640}"
              HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}">

            <!-- Шапка -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" Padding="4,12,6,8">
                <Image Grid.Column="0" Source="icon_to_back.png" WidthRequest="36" HeightRequest="36" VerticalOptions="Center" HorizontalOptions="Start">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Image.GestureRecognizers>
                </Image>
                <controls:AvatarView Grid.Column="1" Source="{Binding OtherAvatar}" IsSystem="{Binding IsSystemChat}" Size="42" VerticalOptions="Center">
                    <controls:AvatarView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenOtherProfileCommand}" />
                    </controls:AvatarView.GestureRecognizers>
                </controls:AvatarView>
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="0">
                    <Label Text="{Binding OtherLogin}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource AppAccentText}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenOtherProfileCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="{Binding StatusText}" FontSize="11" TextColor="{Binding StatusColor}" />
                </VerticalStackLayout>
                <!-- Лупа (перевёрнутая, тоньше) -->
                <Path Grid.Column="3" WidthRequest="24" HeightRequest="24" Aspect="Uniform"
                      Stroke="{StaticResource AppBrown}" StrokeThickness="4" StrokeLineCap="Round"
                      Fill="Transparent" VerticalOptions="Center"
                      Data="M57,18 A25,25 0 1,1 57,68 A25,25 0 1,1 57,18 Z M40,61 L16,84">
                    <Path.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleSearchCommand}" />
                    </Path.GestureRecognizers>
                </Path>
            </Grid>

            <!-- Тонкая полупрозрачная полоска под шапкой -->
            <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource AppBrown}" Opacity="0.25"
                     BackgroundColor="{StaticResource AppBrown}" />

            <!-- Поиск по чату -->
            <Border Grid.Row="2" IsVisible="{Binding IsSearchVisible}"
                    BackgroundColor="{StaticResource AppInput}" Stroke="{StaticResource AppBrown}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 14" Margin="14,6,14,2" Padding="14,0" HeightRequest="42">
                <Entry Text="{Binding SearchQuery}" Placeholder="Поиск в переписке..."
                       PlaceholderColor="{StaticResource AppTextSecondary}"
                       TextColor="{StaticResource AppTextPrimary}" BackgroundColor="Transparent" VerticalOptions="Center" />
            </Border>

            <!-- Сообщения -->
            <CollectionView Grid.Row="3" ItemsSource="{Binding Messages}" Margin="12,6">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MessageItemViewModel">
                        <!-- Свайп влево по своему сообщению открывает «Удалить» (надёжно на телефоне),
                             правый клик удаляет на ПК. У чужих сообщений пункт скрыт. -->
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItemView IsVisible="{Binding IsMine}" Command="{Binding DeleteCommand}">
                                        <Border BackgroundColor="{StaticResource AppError}" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12" Margin="6,4" Padding="18,0"
                                                VerticalOptions="Fill" HorizontalOptions="Fill">
                                            <Label Text="Удалить" TextColor="White" FontAttributes="Bold"
                                                   VerticalOptions="Center" HorizontalOptions="Center" />
                                        </Border>
                                    </SwipeItemView>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Grid Padding="0,4" BackgroundColor="Transparent">
                            <Border StrokeThickness="0" BackgroundColor="{StaticResource AppInput}"
                                    Padding="12,8" HorizontalOptions="Start" MaximumWidthRequest="320">
                                <!-- Меньший угол со стороны отправителя: у собеседника — снизу слева -->
                                <Border.StrokeShape>
                                    <shapes:RoundRectangle CornerRadius="16,16,4,16" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="True">
                                        <Setter Property="HorizontalOptions" Value="End" />
                                        <Setter Property="BackgroundColor" Value="{StaticResource AppBrown}" />
                                        <!-- У меня — меньший угол снизу справа -->
                                        <Setter Property="StrokeShape">
                                            <Setter.Value>
                                                <shapes:RoundRectangle CornerRadius="16,16,16,4" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Text}" FontSize="14" TextColor="{StaticResource AppTextPrimary}"
                                           IsVisible="{Binding Text, Converter={StaticResource ImageMessageConverter}, ConverterParameter=istext}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsSubscriptionRequest}">
                                        <Button Text="Одобрить" Command="{Binding ApproveRequestCommand}"
                                                BackgroundColor="{StaticResource AppOlive}" TextColor="White"
                                                CornerRadius="12" HeightRequest="32" FontSize="12" Padding="12,0" />
                                        <Button Text="Отклонить" Command="{Binding RejectRequestCommand}"
                                                BackgroundColor="{StaticResource AppError}" TextColor="White"
                                                CornerRadius="12" HeightRequest="32" FontSize="12" Padding="12,0" />
                                    </HorizontalStackLayout>
                                    <Button Text="Открыть публикацию" Command="{Binding OpenMentionPostCommand}"
                                            IsVisible="{Binding IsMentionNotification}"
                                            BackgroundColor="{StaticResource AppNavAccent}" TextColor="White"
                                            CornerRadius="12" HeightRequest="32" FontSize="12" Padding="12,0"
                                            HorizontalOptions="Start" />
                                    <Image Source="{Binding Text, Converter={StaticResource ImageMessageConverter}, ConverterParameter=source}"
                                           Aspect="AspectFill" HeightRequest="180" WidthRequest="180"
                                           IsVisible="{Binding Text, Converter={StaticResource ImageMessageConverter}, ConverterParameter=isimage}" />
                                    <!-- Время сообщения -->
                                    <Label Text="{Binding SentAt, Converter={StaticResource MessageTimeConverter}}"
                                           FontSize="10" HorizontalOptions="End" TextColor="{StaticResource AppTextSecondary}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                                <Setter Property="TextColor" Value="#E8D9C0" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                                <!-- ПКМ (десктоп) — удалить -->
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Buttons="Secondary" Command="{Binding DeleteCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Сообщений пока нет" TextColor="{StaticResource AppTextSecondary}"
                           HorizontalTextAlignment="Center" Margin="0,40,0,0" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Ввод -->
            <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="12,8,12,14"
                  IsVisible="{Binding CanSendMessages}">
                <!-- Скрепка (иконка со своей обводкой) -->
                <Image Grid.Column="0" Source="icon_add_files_in_chat.png" WidthRequest="46" HeightRequest="46" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AttachCommand}" />
                    </Image.GestureRecognizers>
                </Image>

                <!-- Поле ввода: скругление как у кнопок + жирная обводка цвета меню -->
                <Border Grid.Column="1" BackgroundColor="{StaticResource AppInput}"
                        Stroke="{StaticResource AppNavAccent}" StrokeThickness="2.5"
                        StrokeShape="RoundRectangle 14" Padding="14,0" HeightRequest="46">
                    <Entry Text="{Binding MessageText}" Placeholder="Сообщение..."
                           PlaceholderColor="{StaticResource AppTextSecondary}"
                           TextColor="{StaticResource AppTextPrimary}" BackgroundColor="Transparent"
                           VerticalOptions="Center" ReturnCommand="{Binding SendCommand}" />
                </Border>

                <!-- Отправка (иконка со своей обводкой) -->
                <Image Grid.Column="2" Source="icon_send.png" WidthRequest="46" HeightRequest="46" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendCommand}" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
